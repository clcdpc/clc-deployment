{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "kind",
    "sourceClass",
    "repository",
    "sourceCommit",
    "reference",
    "releaseId",
    "channel",
    "orderingKind",
    "sequence",
    "tag",
    "integrationCommit",
    "integrationBranch"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "tag",
        "snapshot"
      ]
    },
    "sourceClass": {
      "enum": [
        "IntegrationTag",
        "ReviewedPr",
        "ProtectedBranch"
      ]
    },
    "repository": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"
    },
    "sourceCommit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "reference": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "releaseId": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "channel": {
      "enum": [
        "DEV",
        "Production",
        "ArtifactOnly",
        "Test"
      ]
    },
    "orderingKind": {
      "enum": [
        "SemVer",
        "Snapshot"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "tag": {
      "maxLength": 64,
      "type": [
        "string",
        "null"
      ]
    },
    "integrationCommit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "integrationBranch": {
      "maxLength": 100,
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_/-]*$"
    }
  }
}
